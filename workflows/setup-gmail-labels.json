        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Every Launchbench label (docs/workflow-design.md section 6), parents before\n// children so Gmail nests them. Labels that already exist are skipped.\nconst WANT = ['Launchbench', 'Launchbench/Error',\n  'Launchbench/Lead', 'Launchbench/Lead/Hot', 'Launchbench/Lead/Warm', 'Launchbench/Lead/Cold',\n  'Launchbench/Issue', 'Launchbench/Issue/P1', 'Launchbench/Issue/P2', 'Launchbench/Issue/P3', 'Launchbench/Issue/P4',\n  'Launchbench/Billing',\n  'Launchbench/Vendor', 'Launchbench/Vendor/Pass', 'Launchbench/Vendor/Hold', 'Launchbench/Vendor/Flag', 'Launchbench/Vendor/Fraud',\n  'Launchbench/Change', 'Launchbench/Query', 'Launchbench/Noise', 'Launchbench/Awaiting approval',\n  'Launchbench/Demo', 'Launchbench/Demo/Assigned member'];\nconst have = $input.all().map(i => i.json.name);\nreturn WANT.filter(n => !have.includes(n)).map(name => ({ json: { name } }));"
      }
    },
