    {
      "id": "52619c63-b097-42cb-a64b-292db0df5e86",
      "name": "Parse seed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const personas = $('Read personas').all().map(p => p.json);\nconst pdfIds = {};\nfor (const a of $('List kit attachments').all()) pdfIds[a.json.name] = a.json.id;\n// Triage only: WF-0 classifies and logs each seed but runs no handler (no replies,\n// staff emails or approval cards). Turn it off in \"Which seeds\" for a full end-to-end run.\nconst triageOnly = Boolean($('Which seeds').first().json.triage_only);\n\nconst out = [];\nfor (const [index, item] of $input.all().entries()) {\n  const md = String(item.json.md || '').replace(/\\r/g, '');\n  const m = md.match(/^---\\n([\\s\\S]*?)\\n---\\n([\\s\\S]*)$/);\n  if (!m) throw new Error('Seed file without front matter: ' + $('Keep chosen seeds').all()[index].json.name);\n  const fm = {};\n  for (const line of m[1].split('\\n')) {\n    const kv = line.match(/^([a-z_]+):\\s?(.*)$/);\n    if (kv) fm[kv[1]] = kv[2].trim();\n  }\n  const from = (fm.from || '').match(/^(.*?)\\s*<([^>]+)>$/) || [null, '', fm.from || ''];\n  const address = from[2].toLowerCase();\n  const persona = personas.find(p => String(p.as_email).toLowerCase() === address);\n  const pdf = (fm.attachments || '').match(/attachments\\/([\\w.-]+\\.pdf)/);\n  out.push({\n    json: {\n      seed_id: String(fm.id).padStart(2, '0'),\n      seed_now: fm.date,\n      from_address: address,\n      from_name: from[1].replace(/^\"|\"$/g, ''),\n      subject: (persona ? '[as ' + persona.alias + '] ' : '') + (fm.subject || ''),\n      body: m[2].trim(),\n      expected_class: fm.expected_class || '',\n      pdf_name: pdf ? pdf[1] : '',\n      pdf_id: pdf ? (pdfIds[pdf[1]] || '') : '',\n      triage_only: triageOnly\n    },\n    pairedItem: { item: index }\n  });\n}\nreturn out.sort((a, b) => a.json.seed_id.localeCompare(b.json.seed_id));"
      }
    },
